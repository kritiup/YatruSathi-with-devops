# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Public base URL of this backend, used to build absolute media URLs.
# Leave blank for local development.
BACKEND_URL=

# --- Built-in admin account ---
# The admin panel login. ADMIN_PASSWORD has no default — admin login is
# disabled (503) until you set it. Use a strong, unique value.
ADMIN_EMAIL=admin@yatrusathi.local
ADMIN_PASSWORD=

# --- Database (PostgreSQL — required) ---
# The app has no local-file fallback; it will refuse to start without one of
# the two forms below.
#
# Preferred: a single DSN. This is what docker-compose and Kubernetes set.
DATABASE_URL=postgres://yatrusathi:yatrusathi-dev-password@localhost:5432/yatrusathi
#
# Or the discrete parts, used when DATABASE_URL is unset:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=yatrusathi
# POSTGRES_USER=yatrusathi
# POSTGRES_PASSWORD=yatrusathi-dev-password
#
# Require TLS to the database. True for managed Postgres (RDS), False for a
# local container on the same Docker network.
DB_SSL_REQUIRE=False
# Seconds to reuse a connection for; 0 disables persistent connections.
DB_CONN_MAX_AGE=600

# --- Seeding (scripts/seed_db.py, run on container start) ---
# The catalogue (destinations, activity types, activities, packages) is seeded
# only when it is empty. Set SEED_FORCE=1 to re-apply it over existing rows.
SEED_FORCE=

# Demo logins, bookings and reviews. Off by default, and ignored entirely when
# DEBUG=False — a production deploy can never seed accounts.
SEED_DEMO_DATA=
SEED_DEMO_PASSWORD=demo-password-change-me

# --- Email (OTP + password reset) ---
# Resend is tried first over its HTTP API; SMTP below is the fallback.
RESEND_API_KEY=

# IMPORTANT: `onboarding@resend.dev` is Resend's shared sandbox sender. With it,
# Resend delivers ONLY to the email address that owns the API key — every other
# recipient is refused with HTTP 403, so password reset works for you and no one
# else. To send to real users, verify a domain at resend.com/domains and set
# this to an address on that domain (e.g. no-reply@yourdomain.com).
RESEND_FROM_EMAIL=onboarding@resend.dev

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com
