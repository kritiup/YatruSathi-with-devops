# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Public base URL of this backend, used to build absolute media URLs.
# Leave blank for local development.
BACKEND_URL=

# --- Built-in admin account ---
# The admin panel login. ADMIN_PASSWORD has no default — admin login is
# disabled (503) until you set it. Use a strong, unique value.
ADMIN_EMAIL=admin@yatrusathi.local
ADMIN_PASSWORD=

# --- Database ---
# SQLite is used unconditionally. Set this only to move the file elsewhere.
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# --- Email ---
# Resend is preferred; SMTP below is the local/dev fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com
