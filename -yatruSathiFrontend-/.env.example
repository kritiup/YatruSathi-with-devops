# Copy to .env and fill in. .env is gitignored.

# Base URL of the backend API — must end with a trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# AI chatbot service (optional; leave blank to disable).
VITE_CHATBOT_URL=http://localhost:5005

# Supabase — the anon/publishable key is safe to expose to the browser
# (row-level security enforces access); never put the service key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
