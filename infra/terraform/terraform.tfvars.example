# Copy to terraform.tfvars and adjust. Every value has a default in
# variables.tf — you can apply with an empty file.

aws_region         = "ap-south-1"
name               = "yatrusathi"
kubernetes_version = "1.31"

# Worker nodes
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

# Database
db_instance_class = "db.t4g.micro"
db_multi_az       = false

# CI OIDC — the repo + branch allowed to deploy
github_repository = "kritiup/YatruSathi-with-devops"
github_deploy_ref = "refs/heads/main"

# Your own IAM user/role ARN(s), so kubectl works from your laptop too
cluster_admin_principals = [
  # "arn:aws:iam::123456789012:role/Admin",
]
