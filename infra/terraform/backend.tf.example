# Copy to backend.tf and fill in a bucket you own, then re-run `terraform init`.
# Until then Terraform keeps state in a local terraform.tfstate file.

terraform {
  backend "s3" {
    bucket       = "CHANGE-ME-yatrusathi-tfstate"
    key          = "eks/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true # S3-native state locking (Terraform >= 1.10)
  }
}
