# ─────────────────────────────────────────────────────────────────────
# Root env — used by docker-compose for interpolation only (ports, tags).
# Each service reads its OWN .env: backend/.env, frontend/.env, chatbot/.env
# (copy each service's .env.example). Never commit any real .env.
# ─────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=yatrusathi

# Host ports published by docker-compose
BACKEND_PORT=8000
CHATBOT_PORT=5005
FRONTEND_PORT=8080

# Image tag applied to locally built images
IMAGE_TAG=local
