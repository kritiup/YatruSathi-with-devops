# ─────────────────────────────────────────────────────────────────────
# Root env for `docker compose up --build`.
#
#   cp .env.example .env      # then edit as needed
#
# Every value here also has a sane default in docker-compose.yml, so the
# stack runs even with NO .env file. Real secrets are blank by default —
# fill them in .env (which is gitignored); never commit them.
# ─────────────────────────────────────────────────────────────────────

# ── Published host ports ────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
CHATBOT_PORT=5005

# Tag for the locally built images
IMAGE_TAG=local

# ── Django backend ─────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-compose-dev-key-change-me
DJANGO_DEBUG=True
# Comma-separated. Defaults already cover localhost + the `backend` service host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Must list the browser origin the SPA is served from (FRONTEND_PORT above).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_SSL_REDIRECT=False
WEB_CONCURRENCY=3

# Optional built-in admin account. Admin login returns 503 until a password is set.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=

# Optional transactional email (OTP). Blank ⇒ no-op.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── AI chatbot (Flask + Socket.IO) ─────────────────────────────────
# Blank GROQ_API_KEY ⇒ the service still runs with templated fallback answers.
CHATBOT_SECRET_KEY=yatrusathi-insecure-compose-dev-key-change-me
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional non-blocking chat logging. Blank ⇒ disabled.
CHATBOT_SUPABASE_URL=
CHATBOT_SUPABASE_KEY=
# Optional Socket.IO message queue. Blank ⇒ single-process rooms.
CHATBOT_REDIS_URL=

# ── React frontend (baked into the bundle at BUILD time) ────────────
# Used by the browser, so it must be the host-published backend URL.
# Defaults to http://localhost:${BACKEND_PORT}/api/ — only set to override.
VITE_API_BASE_URL=

# AI chatbot URL as seen from the browser.
# Defaults to http://localhost:${CHATBOT_PORT} — set blank to disable the assistant.
VITE_CHATBOT_URL=

# ── Supabase — EXTERNAL managed service, never containerised ────────
# The frontend uses these public values directly from the browser (the anon
# key is protected by row-level security). Leave blank to run without Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Error tracking (Sentry) — every value blank ⇒ disabled ─────────
# Use a separate DSN per service. SENTRY_ENVIRONMENT is shared.
SENTRY_ENVIRONMENT=development
SENTRY_DSN_BACKEND=
SENTRY_DSN_CHATBOT=
VITE_SENTRY_DSN=
