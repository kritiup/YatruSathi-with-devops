# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Flask ---
SECRET_KEY=replace-me-with-a-random-secret

# --- Groq (LLM) ---
# Get a free key at https://console.groq.com/keys
# Unset ⇒ the service still runs and answers from the knowledge base.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (optional: non-blocking chat logging) ---
# Leave blank to disable logging. Use the service key only on the server.
SUPABASE_URL=
SUPABASE_KEY=
